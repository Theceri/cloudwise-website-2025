# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Full step-by-step walkthrough: docs/PAYMENTS_SETUP.md
# ---------------------------------------------------------------------------

# ---- Sanity (blog + training registrations) -------------------------------
# Create a project at https://www.sanity.io/manage (free).

# Public — safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only secrets (never exposed to the browser).
# Tokens: sanity.io/manage -> API -> Tokens
SANITY_API_READ_TOKEN=          # Viewer token — draft preview
SANITY_API_WRITE_TOKEN=         # Editor token — comments AND registrations

# Random strings you choose (e.g. `openssl rand -hex 16`).
SANITY_DRAFT_SECRET=            # protects /api/draft
SANITY_REVALIDATE_SECRET=       # protects /api/revalidate webhook


# ---- Where payment providers call us back ---------------------------------
# Leave unset in production — the live domain is used automatically.
# In development, run a tunnel and paste its https address here:
#   ngrok http 3000     -or-     cloudflared tunnel --url http://localhost:3000
#
# A quick tunnel gets a brand new hostname every time it restarts, and Safaricom
# keeps posting to whichever address was registered last — so a restart silently
# throws away every C2B confirmation until you update this value AND re-run
# /api/payments/mpesa/register-urls. If you test paybill payments often, use a
# named tunnel on a subdomain you own instead; the address never changes and you
# register it with Safaricom once.
PUBLIC_BASE_URL=


# ---- M-Pesa / Safaricom Daraja (collection) -------------------------------
# https://developer.safaricom.co.ke -> My Apps
MPESA_ENVIRONMENT=sandbox           # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379              # sandbox test paybill; use yours in production
MPESA_PASSKEY=
# The paybill customers are told to pay to. Defaults to MPESA_SHORTCODE.
MPESA_DISPLAY_PAYBILL=

# Set to false to offer the STK prompt only — no paybill number on the checkout
# page and none in the emails.
#
# Use this whenever you are not certain Safaricom is delivering C2B
# confirmations to this deployment. The code cannot check for you: on a live
# shortcode the URLs can be registered once only, there is no read-back
# endpoint, and a stale registration fails silently — the customer pays, the
# money arrives, and nothing tells us. Showing a paybill in that state turns a
# helpful fallback into a way to lose people's money.
#
# Turn it back on once Safaricom confirms the registered URLs point at the live
# domain. Left unset, the fallback is offered whenever M-Pesa is configured.
PAYBILL_FALLBACK_ENABLED=

# Only needed for B2B bank settlement (below). The security credential is
# derived at runtime from these plus the Safaricom certificate in the project
# root (ProductionCertificate.cer / SandboxCertificate.cer) — the certificates
# are public files, so there is no certificate value to set here.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=


# ---- Paystack (card payments only) ----------------------------------------
# https://dashboard.paystack.com -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Set to false to launch on M-Pesa alone while Paystack approval is pending.
# Checkout then shows M-Pesa with no card tab at all — not a card tab that
# apologises — and the card endpoint refuses requests, so a stale page cannot
# start a payment that cannot complete. Remove it (or set true) on approval;
# nothing else changes. Left unset, cards are offered whenever the keys exist.
CARD_PAYMENTS_ENABLED=


# ---- Automatic settlement to the Cloudwise bank account -------------------
# Sweeps each confirmed M-Pesa collection into the bank.
SETTLEMENT_ENABLED=false
SETTLEMENT_ADAPTER=none             # none | daraja-b2b | sasapay
SETTLEMENT_BANK_NAME=Equity Bank
SETTLEMENT_ACCOUNT_NUMBER=          # the Cloudwise bank account number
SETTLEMENT_MODE=full                # full | percentage | fixed
SETTLEMENT_VALUE=0                  # percent, or fixed KES — ignored when full
SETTLEMENT_MIN_AMOUNT=0             # don't sweep collections below this
SETTLEMENT_FLOAT_BUFFER=0           # always leave this much in the paybill

# daraja-b2b only: the bank's deposit paybill. Equity is 247247.
SETTLEMENT_BANK_PAYBILL=247247


# ---- SasaPay (alternative rail: collection and/or bank settlement) --------
# https://developer.sasapay.app
SASAPAY_BASE_URL=https://sandbox.sasapay.app/api/v1
SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=
SASAPAY_MERCHANT_CODE=
SASAPAY_SETTLEMENT_CHANNEL=68       # 68 = Equity Bank


# ---- Email (Resend) -------------------------------------------------------
# https://resend.com -> API Keys
RESEND_API_KEY=
EMAIL_FROM=Cloudwise Training <training@cloudwise.co.ke>
EMAIL_REPLY_TO=hello@cloudwise.co.ke
# Comma-separated. Everyone here gets signup alerts and the 5pm digest.
ADMIN_EMAILS=hello@cloudwise.co.ke


# ---- Scheduled jobs -------------------------------------------------------
# A random string you choose. Protects /api/cron/* and /api/test/emails.
CRON_SECRET=

# --- Test mode -------------------------------------------------------------
# Optional. Charge this token amount (KES) instead of the real course price so
# STK push, C2B, part payments and settlement can all be tested cheaply.
# Displayed course prices are NOT affected — only what a registration is
# charged. Use 2 rather than 1 so that paying 1 exercises the part-payment path.
# MUST be unset in production.
# TEST_PAYMENT_AMOUNT_KES=2
